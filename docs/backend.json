
{
  "entities": {
    "InventoryItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "InventoryItem",
      "type": "object",
      "description": "Represents an item in the inventory.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the inventory item."
        },
        "purchaseInvoiceNumber": {
          "type": "string",
          "description": "The purchase invoice number associated with the item."
        },
        "vendorName": {
          "type": "string",
          "description": "The name of the vendor from whom the item was purchased."
        },
        "purchaseDate": {
          "type": "string",
          "description": "The date the item was purchased.",
          "format": "date-time"
        },
        "itemStdCode": {
          "type": "string",
          "description": "The standard code of the item."
        },
        "itemCategory": {
          "type": "string",
          "description": "The category of the item (e.g., Vehicle Part, Spare, Accessories)."
        },
        "productName": {
          "type": "string",
          "description": "The name of the product."
        },
        "productDetails": {
          "type": "string",
          "description": "Detailed description of the product."
        },
        "quantity": {
          "type": "number",
          "description": "The quantity of the item in stock."
        },
        "storageLocation": {
          "type": "string",
          "description": "The location where the item is stored."
        },
        "unitPrice": {
          "type": "number",
          "description": "The unit price of the item."
        },
        "purchasePrice": {
          "type": "number",
          "description": "The purchase price of the item."
        },
        "itemStatus": {
          "type": "string",
          "description": "The current status of the item (e.g., In Stock, Sold, Damaged)."
        },
        "salesInvoiceNumber": {
          "type": "string",
          "description": "The sales invoice number associated with the item, if any."
        },
        "salesDate": {
            "type": "string",
            "description": "The date the item was sold.",
            "format": "date-time"
        },
        "customerId": {
          "type": "string",
          "description": "The ID of the customer who purchased the item, if sold."
        }
      },
      "required": [
        "id",
        "purchaseInvoiceNumber",
        "vendorName",
        "purchaseDate",
        "itemStdCode",
        "itemCategory",
        "productName",
        "quantity",
        "storageLocation",
        "unitPrice",
        "purchasePrice",
        "itemStatus"
      ]
    },
    "user": {
      "title": "User",
      "description": "Represents a user of the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "description": "The user's role.",
          "enum": [
            "owner",
            "administrator",
            "employee"
          ]
        }
      },
      "required": [
        "uid",
        "email",
        "role"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/inventory/{itemId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/InventoryItem"
          },
          "description": "Stores all inventory items."
        }
      },
      {
        "path": "/vehicleModels/{modelId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/VehicleModel"
          },
          "description": "Stores vehicle model definitions."
        }
      },
      {
        "path": "/assembledVehicles/{vehicleId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/AssembledVehicle"
          },
          "description": "Stores assembled vehicle records."
        }
      },
      {
        "path": "/batteryModels/{modelId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/BatteryModel"
          },
          "description": "Stores battery model definitions."
        }
      },
      {
        "path": "/assembledBatteries/{batteryId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/AssembledBattery"
          },
          "description": "Stores assembled battery records."
        }
      },
      {
        "path": "/customers/{customerId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Customer"
          },
          "description": "Stores customer information."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/user"
          },
          "description": "Stores user profile data and roles."
        }
      }
    ]
  }
}
