/**
 * Core Philosophy:
 * This ruleset is designed for an internal inventory management application.
 * The core security principle is that any authenticated user within the organization
 * can view all data, but write operations (creating, updating, or deleting items)
 * are strictly controlled.
 *
 * Data Structure:
 * The data is structured across multiple top-level collections for different
 * data models (inventory, vehicleModels, customers, etc.).
 *
 * Key Security Decisions:
 * 1. Authenticated Reads: To prevent public data exposure, all read operations
 *    (get, list) across all collections require the user to be signed in.
 * 2. Writes Controlled: Write permissions will be granted based on user roles
 *    (owner, administrator) which will be implemented in future rules.
 *    For now, most writes are disabled to maintain a secure-by-default posture.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }


    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description
     *   Manages access to all inventory items.
     * @path /inventory/{inventoryId}
     */
    match /inventory/{inventoryId} {
      allow read;
      allow write: if isSignedIn();
    }
    
    /**
     * @description
     *   Manages vehicle models (blueprints for assembly).
     * @path /vehicleModels/{modelId}
     */
    match /vehicleModels/{modelId} {
      allow read;
      allow write: if isSignedIn();
    }

    /**
     * @description
     *   Manages assembled vehicles records.
     * @path /assembledVehicles/{vehicleId}
     */
    match /assembledVehicles/{vehicleId} {
      allow read;
      allow write: if isSignedIn();
    }

    /**
     * @description
     *   Manages battery models (blueprints for assembly).
     * @path /batteryModels/{modelId}
     */
    match /batteryModels/{modelId} {
      allow read;
      allow write: if isSignedIn();
    }

    /**
     * @description
     *   Manages assembled battery records.
     * @path /assembledBatteries/{batteryId}
     */
    match /assembledBatteries/{batteryId} {
      allow read;
      allow write: if isSignedIn();
    }

    /**
     * @description
     *   Manages customer records.
     * @path /customers/{customerId}
     */
    match /customers/{customerId} {
      allow read;
      allow write: if isSignedIn();
    }
  }
}
